# Never commit real Slack tokens.
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-level-token
SLACK_ALERT_USER_ID=U0123456789

# Must match the slash command configured in Slack.
SLACK_COMMAND=/swingengine
LOG_LEVEL=INFO

# Manual Upstox token management (no public webhook required).
UPSTOX_TOKEN_MANAGEMENT_ENABLED=true
UPSTOX_TOKEN_MONITOR_ENABLED=true
UPSTOX_TOKEN_CHECK_INTERVAL_SECONDS=10800
UPSTOX_TOKEN_ROTATION_ENABLED=false
UPSTOX_WEBHOOK_ENABLED=false
UPSTOX_EXPECTED_USER_ID=YOUR_UPSTOX_UCC
UPSTOX_TOKEN_FILE=/tmp/swingengine/upstox-token.json
