# Never commit real Slack tokens.
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-level-token
# Receives token alerts and is authorized for auth/tracker administration.
SLACK_ALERT_USER_ID=U0123456789

# Must match the slash command configured in Slack.
SLACK_COMMAND=/swingengine
LOG_LEVEL=INFO

# PostgreSQL persistence for saved assets and tracker entries.
SWINGENGINE_DATABASE_URL=postgresql://swingengine_app:change-me@postgres:5432/swingengine
SWINGENGINE_DATABASE_CONNECT_TIMEOUT_SECONDS=10

# Manual Upstox token management (no public webhook required). Upstox is
# used for all candle/quote fetching.
UPSTOX_TOKEN_MANAGEMENT_ENABLED=true
UPSTOX_TOKEN_MONITOR_ENABLED=true
UPSTOX_TOKEN_CHECK_INTERVAL_SECONDS=10800
UPSTOX_TOKEN_ROTATION_ENABLED=false
UPSTOX_WEBHOOK_ENABLED=false
UPSTOX_EXPECTED_USER_ID=YOUR_UPSTOX_UCC
UPSTOX_TOKEN_FILE=/tmp/swingengine/upstox-token.json

# Manual Zerodha (Kite Connect) token management. Zerodha is used for order
# placement. Generate the access_token via the Kite login flow, then submit
# it with `/swingengine auth set zerodha <token>`.
ZERODHA_TOKEN_MANAGEMENT_ENABLED=true
ZERODHA_API_KEY=YOUR_KITE_API_KEY
ZERODHA_EXPECTED_USER_ID=YOUR_ZERODHA_CLIENT_ID
ZERODHA_TOKEN_FILE=/tmp/swingengine/zerodha-token.json

# Rate-safe spacing for catalogue-wide momentum history requests.
SWINGENGINE_MOMENTUM_SCAN_LOOKBACK_DAYS=365
SWINGENGINE_MOMENTUM_SCAN_MINIMUM_CANDLES=200
SWINGENGINE_MOMENTUM_SCAN_REQUEST_INTERVAL_SECONDS=1.0
